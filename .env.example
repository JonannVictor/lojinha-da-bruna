# Copie para .env.local e ajuste. Nunca versione .env.local.
# Guia completo: docs/supabase.md e docs/configuracao.md.

# --- Supabase (Project Settings → API Keys) --------------------------------
# URL do projeto, ex.: https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Chave PUBLICÁVEL (sb_publishable_…). Vai para o navegador; o acesso é
# controlado pelo RLS. Nunca coloque aqui a chave secreta.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave SECRETA (sb_secret_…). Somente servidor; usada apenas para registrar
# pedidos. Sem o prefixo NEXT_PUBLIC_. Pode ficar vazia enquanto a finalização
# de pedidos estiver desligada.
SUPABASE_SECRET_KEY=

# --- Modo demonstração -------------------------------------------------------
# "true": loja e painel funcionam sem Supabase, com dados fictícios salvos só
# no navegador e painel SEM LOGIN. Apenas para apresentação; o build falha em
# produção na Vercel. Exige reiniciar o servidor. Veja docs/demonstracao.md.
NEXT_PUBLIC_DEMO_MODE=

# --- Catálogo ----------------------------------------------------------------
# Vazio (padrão): usa o Supabase se configurado; senão, catálogo vazio.
# "demo": produtos fictícios para testar a interface (ignorado em produção).
# "empty": força o catálogo vazio.
CATALOG_SOURCE=

# --- Pedidos -----------------------------------------------------------------
# Opcional. O número oficial (+55 54 8139-4629) fica em src/config/store.ts.
# Preencha só para usar outro número neste ambiente (ex.: testes), com DDI e
# DDD, apenas dígitos. Vazio ou inválido: usa o número oficial.
WHATSAPP_NUMBER=
