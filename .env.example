# Copie para .env.local e ajuste. Nunca versione .env.local.

# Fonte do catálogo: "empty" (padrão, catálogo vazio) ou "demo" (produtos
# fictícios para testar a interface). "demo" é ignorado em produção na Vercel.
CATALOG_SOURCE=empty

# Número de WhatsApp da Bruna, com DDI e DDD, apenas dígitos (ex.: 55 + DDD + número).
# PENDENTE: aguardando o número oficial. Deixe vazio até ser confirmado.
WHATSAPP_NUMBER=
