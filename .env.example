# Copie para .env.local e ajuste. Nunca versione .env.local.
# Guia completo: docs/supabase.md e docs/configuracao.md.

# --- Supabase (Project Settings → API Keys) --------------------------------
# URL do projeto, ex.: https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Chave PUBLICÁVEL (sb_publishable_…). Vai para o navegador; o acesso é
# controlado pelo RLS. Nunca coloque aqui a chave secreta.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave SECRETA (sb_secret_…). Somente servidor; usada apenas para registrar
# pedidos. Sem o prefixo NEXT_PUBLIC_. Pode ficar vazia enquanto a finalização
# de pedidos estiver desligada.
SUPABASE_SECRET_KEY=

# --- Catálogo ----------------------------------------------------------------
# Vazio (padrão): usa o Supabase se configurado; senão, catálogo vazio.
# "demo": produtos fictícios para testar a interface (ignorado em produção).
# "empty": força o catálogo vazio.
CATALOG_SOURCE=

# --- Pedidos -----------------------------------------------------------------
# Número de WhatsApp da Bruna, com DDI e DDD, apenas dígitos (ex.: 55 + DDD + número).
# PENDENTE: aguardando o número oficial. Enquanto vazio, a finalização de
# pedidos fica desligada.
WHATSAPP_NUMBER=
